{
  "compilerOptions": {
    "baseUrl": "./appData/ts",
    "paths": { "@root/*": [ "./*" ] },
    "target": "ES2020",
    "module": "ESNext",
    "sourceMap": true,
    "outDir": "./appData/js",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": false, //Windowsは大文字小文字判定を行わない
    "moduleResolution": "node",
    "skipLibCheck": true,
    "types": [ "node" ]
  },
  "include": [
    "./appData/ts/**/*"
  ]
}
