const builder = require('electron-builder');

builder.build({
    config: {
        'appId': 'electorn-print',
        'win':{
            'target': {
                'target': 'zip',
                'arch': [
                    'x64',
                    'ia32',
                ]
            }
        },
        extraFiles: [
            {
                from: "./appData/json/setting.json",
                to: "./config/setting.json"
            },
            {
                from: "./appData/menu.html",
                to: "./config/menu.html"
            }
        ],
        'asar': true
    }
});