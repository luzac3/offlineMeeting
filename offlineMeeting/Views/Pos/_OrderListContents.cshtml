@using offlineMeeting.Models.Entity.Pos;
@model offlineMeeting.Models.ViewModel.PosViewModel;

@{
    foreach (OrderEntity orderEntity in Model.OrderEntityList ?? new List<OrderEntity> { })
    {
        @if (orderEntity.AlcoholDataEntity != null)
        {
            <div id="alchol_@orderEntity.OrderPostEntity.ResultId" class="order order_list" data-result_id="@orderEntity.OrderPostEntity.ResultId">
                <input class="category nodisplay" value="2" />
                <div class="image_container">
                    @if (@orderEntity.AlcoholDataEntity?.Image != null)
                    {
                        @if ((@orderEntity.AlcoholDataEntity.Image) == "")
                        {
                            <img src="/Pos/NoImageRender?src=/image/noImage.jpg"
                                 data-src="/image/noImage.jpg"
                                 class="food_image blur-up"
                                 width="@orderEntity.AlcoholDataEntity.Width"
                                 height="@orderEntity.AlcoholDataEntity.Height"
                                 loading="lazy" />
                        }
                        else
                        {
                            <a href="@(orderEntity.AlcoholDataEntity!.Image)" class="food_image_wrapper js-smartPhoto" data-caption="test" data-id="test" data-group="sake">
                                <img 
                                    src="@(orderEntity.AlcoholDataEntity.LowImage)" 
                                    data-src="@(orderEntity.AlcoholDataEntity.Image)"
                                     class="food_image blur-up"
                                     width="@orderEntity.AlcoholDataEntity.Width"
                                     height="@orderEntity.AlcoholDataEntity.Height"
                                    loading="lazy" />
                            </a>
                        }
                    }
                </div>
                <div class="caption">
                    <p>
                        <span class="alcohol_name">@orderEntity.AlcoholDataEntity?.AlcoholName</span>
                        <span class="rarity">☆@(orderEntity.AlcoholDataEntity?.Rarity)</span>
                        @switch (orderEntity.OrderPostEntity.AlcoholAmount)
                        {
                            case 36:
                                <span>2勺(36ml)</span>
                                ;
                                break;
                            case 180:
                                <span>1合(180ml)</span>
                                ;
                                break;
                            default:
                                <span>全購入(残数購入)</span>
                                ;
                                break;
                        }
                        <input class="alcohol_amount nodisplay" value="@(orderEntity.OrderPostEntity.AlcoholAmount)" />
                    </p>
                    <p class="counter">
                        <span>注文数:</span>
                        <button type="button" class="counter_decrement">-</button>
                        <input type="number" class="order_number counter_number" value="@(orderEntity.OrderPostEntity.OrderNumber)" min="0" max="5" />
                        <button type="button" class="counter_increment">+</button>
                    </p>
                    <p>
                        <img class="poncoin_img" src="/image/poncoin_192.png" />
                        <span>×</span>
                        <span class="coin_number_show">@(orderEntity.OrderPostEntity.OrderCoins)</span>
                        <input class="purhcase_coin_number nodisplay" value="@(orderEntity.OrderPostEntity.OrderCoins)" disabled />
                        <input class="coin_number nodisplay" value="@(orderEntity.OrderPostEntity.OrderCoins)" />
                    </p>
                </div>
            </div>
        }
        else if (orderEntity.PurchaseDataEntity != null)
        {
            <div id="alchol_@orderEntity.OrderPostEntity.ResultId" class="order order_list" data-result_id="@orderEntity.OrderPostEntity.ResultId">
                <input class="category nodisplay" value="1" />
                <div class="image_container">
                    @if (@orderEntity.PurchaseDataEntity?.Image != null)
                    {
                        @if ((@orderEntity.PurchaseDataEntity.Image) == "")
                        {
                            <img src="/Pos/NoImageRender?src=/image/noImage.jpg"
                                 data-src="/image/noImage.jpg"
                                 class="food_image blur-up"
                                 width="@orderEntity.PurchaseDataEntity.Width"
                                 height="@orderEntity.PurchaseDataEntity.Height"
                                 loading="lazy" />
                        }
                        else
                        {
                            <a href="@(orderEntity.PurchaseDataEntity!.Image)" class="food_image_wrapper js-smartPhoto" data-caption="test" data-id="test" data-group="sake">
                                <img src="@(orderEntity.PurchaseDataEntity.LowImage)"
                                     data-src="@(orderEntity.PurchaseDataEntity.Image)"
                                     class="food_image blur-up"
                                     width="@orderEntity.PurchaseDataEntity.Width"
                                     height="@orderEntity.PurchaseDataEntity.Height"
                                     loading="lazy" />
                            </a>
                        }
                    }
                </div>
                <div class="caption">
                    <p>
                        <span class="food_name">@orderEntity.PurchaseDataEntity?.PurchaseName</span>
                    </p>
                    <p class="counter">
                        <span>注文数:</span>
                        <button type="button" class="counter_decrement">-</button>
                        <input type="number" class="order_number counter_number" value="@(orderEntity.OrderPostEntity.OrderNumber)" min="0" max="5" />
                        <button type="button" class="counter_increment">+</button>
                    </p>
                    <p>
                        <img class="poncoin_img" src="/image/poncoin_192.png" />
                        <span>×</span>
                        <span class="coin_number_show">@(orderEntity.OrderPostEntity.OrderCoins)</span>
                        <input class="purhcase_coin_number nodisplay" value="@(orderEntity.OrderPostEntity.OrderCoins)" disabled />
                        <input class="coin_number nodisplay" value="@(orderEntity.OrderPostEntity.OrderCoins)" />
                    </p>
                </div>
            </div>
        }

    }
}