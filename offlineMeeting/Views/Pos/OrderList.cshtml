@using offlineMeeting.Models.Entity.Pos;

@{
    ViewData["Title"] = "Alcohol";
}

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/smartphoto@latest/css/smartphoto.min.css">
    <script src="https://unpkg.com/smartphoto@latest/js/smartphoto.min.js"></script>
    <script src="~/js/dist/OrderList.js" defer></script>
    <link rel="stylesheet" href="~/css/Pos/Index.css" asp-append-version="true" />
    <script>
         document.addEventListener('DOMContentLoaded', function () {
            new SmartPhoto(".js-smartPhoto");
        });
    </script>
}

<div class="text-center">
    <div id="order_list"></div>
    <div id="orders_detail">
        <span>注文情報</span>
        <span>合計ポンコイン：</span><span id="pon_coins">0</span>
        <input id="pon_coins_input" type="text" class="nodisplay" name="pon_coins" value="" />
    </div>
    <div><button id="send_order" type="button">注文確定</button></div>
</div>

<!--注文を送信したら表示も空に-->