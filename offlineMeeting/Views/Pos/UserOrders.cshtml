@using offlineMeeting.Models.Entity.Pos;

@{
    ViewData["Title"] = "ユーザーオーダー";
}

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/smartphoto@latest/css/smartphoto.min.css">
    <script src="https://unpkg.com/smartphoto@latest/js/smartphoto.min.js"></script>
    <script src="~/js/dist/UserOrders.js" defer></script>
    <link rel="stylesheet" href="~/css/Pos/Index.css" asp-append-version="true" />
    <script>
         document.addEventListener('DOMContentLoaded', function () {
            new SmartPhoto(".js-smartPhoto");
        });
    </script>
}

@model offlineMeeting.Models.ViewModel.PosViewModel;
<button id="play-audio" type="button">オーダー受信起動</button>
<table>
    <thead>
        <tr>
            <th>オーダーID</th>
            <th>ユーザー名</th>
            <th>商品番号</th>
            <th>商品名</th>
            <th>数量(分量)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (OrderTableEntity orderTableEntity in Model.OrderTableEntityList ?? new List<OrderTableEntity> { })
        {
            <tr>
                <td>@orderTableEntity?.ResultId</td>
                <td>@orderTableEntity?.UserName</td>
                <td>@orderTableEntity?.PurchaseCd</td>
                <td>@orderTableEntity?.PurchaseName</td>
                <td>
                    @if (orderTableEntity?.AlcoholQuantity == 36)
                    {
                        @($"{orderTableEntity?.Number * 2}勺")
                    }
                    else if (orderTableEntity?.AlcoholQuantity == 180)
                    {
                        @($"{orderTableEntity?.Number}合")
                    }
                    else
                    {
                        @($"{orderTableEntity?.Number}")
                    }
                </td>
            </tr>
        }
    </tbody>
</table>