@using offlineMeeting.Models.Entity.Share;
@using offlineMeeting.Models.Entity.Pos;

@{
    ElectronEntity? electron = ViewData["Electron"] as offlineMeeting.Models.Entity.Share.ElectronEntity;
    @if (electron!.IsElectron)
    {
        Layout = "~/Views/Shared/_LayoutElectron.cshtml";
    }
    ViewData["Title"] = "ユーザーオーダー";
}

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/smartphoto@latest/css/smartphoto.min.css">
    <script src="https://unpkg.com/smartphoto@latest/js/smartphoto.min.js"></script>
    <script src="~/js/UserOrders.js" defer></script>
    <link rel="stylesheet" href="~/css/Pos/Index.css" asp-append-version="true" />
    <script>
         document.addEventListener('DOMContentLoaded', function () {
            new SmartPhoto(".js-smartPhoto");
        });
    </script>
}

<table id="user_order_list"></table>
<div>
    @if (!electron!.IsElectron)
    {
        <br />
        <button id="back" type="button">戻る</button>
    }
</div>