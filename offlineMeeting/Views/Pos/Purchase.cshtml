@using offlineMeeting.Models.Entity.Share;
@using offlineMeeting.Models.Entity.Pos;

@{
    ViewData["Title"] = "Purchase";
}

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/smartphoto@latest/css/smartphoto.min.css">
    <script src="https://unpkg.com/smartphoto@latest/js/smartphoto.min.js"></script>
    <script src="~/js/dist/Pos.js" defer></script>
    <link rel="stylesheet" href="~/css/Pos/Index.css" asp-append-version="true" />
    <script>
         document.addEventListener('DOMContentLoaded', function () {
            new SmartPhoto(".js-smartPhoto");
        });
    </script>
}
@model offlineMeeting.Models.ViewModel.PosViewModel;

<div class="text-center">
    <div id="purchase_order">
        @{
            foreach (PurchaseDataEntity purchaseDataEntity in Model.PurchaseDataEntityList ?? new List<PurchaseDataEntity> { })
            {
                JoinerEntity? userData = ViewData["UserData"] as offlineMeeting.Models.Entity.Share.JoinerEntity;
                @if (purchaseDataEntity.FoodCategory != "1" && purchaseDataEntity.FoodCategory != "2")
                {
                    <div class="order purchase_order food_order modal_parent @(purchaseDataEntity.LeftAmount <= 0 ? "stop_order" : "")">
                        <div id="alchol_@purchaseDataEntity.ResultId" class="alchol_info" data-result_id="@purchaseDataEntity.ResultId">
                            <input class="category nodisplay" value="1" />
                            <div class="open_modal">
                                <p class="food_image_container">
                                    @if (@purchaseDataEntity.Image == "")
                                    {
                                        <img src="/image/noImage.jpg" class="food_image" alt="image" />
                                    }
                                    else
                                    {
                                        <img src="@(purchaseDataEntity.Image)" class="food_image" />
                                    }
                                    @if (purchaseDataEntity.Ordered)
                                    {
                                        <img src="/image/ordered.png" class="orderd" alt="image" />
                                    }
                                </p>
                                <p class="alcoholName">
                                    <span>@(purchaseDataEntity.PurchaseName)</span>
                                </p>
                                <p>
                                    <img class="poncoin_img" src="/image/poncoin.png" />
                                    <span> × </span>
                                    <span class="coin_number_show">@(purchaseDataEntity.CoinNumber)</span>
                                    <input class="purhcase_coin_number nodisplay" value="@(purchaseDataEntity.CoinNumber)" disabled />
                                    <input class="coin_number nodisplay" value="@(purchaseDataEntity.CoinNumber)" disabled />
                                </p>
                                <input type="text" class="left_amount nodisplay" value="@(purchaseDataEntity.LeftAmount)" />
                            </div>
                            <p>
                                <span>×</span>
                                <select class="order_number">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <option value="@i">@i</option>
                                    }
                                </select>
                            </p>
                            <p>
                                @if (purchaseDataEntity.LeftAmount <= 0)
                                {
                                    <span>品切れ</span>
                                }
                                else
                                {
                                    <button class="order_button" type="button">注文に追加</button>
                                }
                            </p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="order food_order modal_parent @(purchaseDataEntity.LeftAmount <= 0 ? "stop_order" : "")">
                        <div id="alchol_@purchaseDataEntity.ResultId" class="alchol_info" data-result_id="@purchaseDataEntity.ResultId">
                            <input class="category nodisplay" value="1" />
                            <div class="open_modal">
                                <p class="food_image_container">
                                    @if (@purchaseDataEntity.Image == "")
                                    {
                                        <img src="/image/noImage.jpg" class="food_image" alt="image" />
                                    }
                                    else
                                    {
                                        <img src="@(purchaseDataEntity.Image)" class="food_image" />
                                    }
                                    @if (purchaseDataEntity.Ordered)
                                    {
                                        <img src="/image/ordered.png" class="orderd" alt="image" />
                                    }
                                </p>
                                <p class="purchaseName">
                                    <span>@(purchaseDataEntity.PurchaseName)</span>
                                </p>
                                <p>
                                    <img class="poncoin_img" src="/image/poncoin.png" />
                                    <span> × </span>
                                    <span class="coin_number_show">@(purchaseDataEntity.CoinNumber)</span>
                                    <input class="purhcase_coin_number nodisplay" value="@(purchaseDataEntity.CoinNumber)" disabled />
                                    <input class="coin_number nodisplay" value="@(purchaseDataEntity.CoinNumber)" disabled />
                                </p>
                                <input type="text" class="left_amount nodisplay" value="@(purchaseDataEntity.LeftAmount)" />
                            </div>
                            <p>
                                <span>×</span>
                                <select class="order_number">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <option value="@i">@i</option>
                                    }
                                </select>
                            </p>
                            <p>
                                @if (purchaseDataEntity.LeftAmount <= 0)
                                {
                                    <span>品切れ</span>
                                }
                                else
                                {
                                    <button class="order_button" type="button">注文に追加</button>
                                }
                            </p>
                        </div>
                    </div>
                }
                
            }
        }
    </div>
    <div>
        <br /><button id="back" type="button">戻る</button>
    </div>
</div>