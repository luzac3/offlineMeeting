@using offlineMeeting.Models.Entity.Share;
@using offlineMeeting.Models.Entity.Pos;

@{
    ViewData["Title"] = "Alcohol";
}

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/smartphoto@latest/css/smartphoto.min.css">
    <script src="https://unpkg.com/smartphoto@latest/js/smartphoto.min.js"></script>
    <script src="~/js/dist/pos.js" defer></script>
    <link rel="stylesheet" href="~/css/Pos/Index.css" asp-append-version="true" />
    <script>
         document.addEventListener('DOMContentLoaded', function () {
            new SmartPhoto(".js-smartPhoto");
        });
    </script>
}
@model offlineMeeting.Models.ViewModel.PosViewModel;

<div class="text-center">
    <div id="purchase_order">
        @{
            foreach (AlcoholDataEntity alcoholDataEntity in Model.AlcoholDataEntityList ?? new List<AlcoholDataEntity> { })
            {
                JoinerEntity? userData = ViewData["UserData"] as offlineMeeting.Models.Entity.Share.JoinerEntity;
                if (userData?.Level + 2 < alcoholDataEntity.Rarity){
                    continue;
                }
                if (alcoholDataEntity.Rarity == 0){
                    continue;
                }
                <div class="purchase_order alcohol_order modal_parent">
                    <div id="alchol_@alcoholDataEntity.ResultId" class="alchol_info" data-result_id="@alcoholDataEntity.ResultId">
                        <input class="category nodisplay" value="2" />
                        <div class="open_modal">
                            <p class="food_image_container">
                                @if (@alcoholDataEntity.Image == "")
                                {
                                    <img src="/image/noImage.jpg" class="food_image" alt="image" />
                                }
                                else
                                {
                                    <img src="@(alcoholDataEntity.Image)" class="food_image" />
                                }
                                @if (alcoholDataEntity.Ordered)
                                {
                                    <img src="/image/ordered.png" class="orderd" alt="image" />
                                }
                                @switch (alcoholDataEntity.Rarity)
                                {
                                    case 0:
                                        <img src="/image/zeroStars.png" class="star" />
                                        break;
                                    case 1:
                                        <img src="/image/singleStars.png" class="star" />
                                        break;
                                    case 2:
                                        <img src="/image/doubleStars.png" class="star" />
                                        break;
                                    case 3:
                                        <img src="/image/tripleStars.png" class="star" />
                                        break;
                                    case 4:
                                        <img src="/image/quadStars.png" class="star" />
                                        break;
                                    case 5:
                                        <img src="/image/fiveStars.png" class="star" />
                                        break;
                                    case 6:
                                        <img src="/image/sixStars.png" class="star" />
                                        break;
                                }
                            </p>
                            <p class="alcoholName">
                                <span>@(alcoholDataEntity.Abbreviation == "" ? alcoholDataEntity.Abbreviation : alcoholDataEntity.AlcoholName)</span>
                            </p>
                            <p class="alcohol_poncoin">
                                <img src="/image/poncoin.png" alt="image" />
                                <span> × </span>
                                <span class="coin_number_show">@(alcoholDataEntity.CoinNumber * 5 - alcoholDataEntity.CoinNumber)</span>
                                <input class="coin_number nodisplay" value="@(alcoholDataEntity.CoinNumber * 5 - alcoholDataEntity.CoinNumber)" disabled />
                            </p>
                            <input type="text" class="coin_per_2shaku nodisplay" value="@(alcoholDataEntity.CoinNumber)" />
                            <input type="text" class="left_amount nodisplay" value="@(alcoholDataEntity.LeftAmount)" />
                        </div>
                        <p>
                            <select class="alcohol_amount">
                                <option value="36">2勺</option>
                                <option value="180" selected>1合</option>
                                <option value="0">1瓶</option>
                            </select>
                            <span>×</span>
                            <select class="order_number">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <option value="@i">@i</option>
                                }
                            </select>
                        </p>
                        <p><button class="order_button" type="button">注文に追加</button></p>
                    </div>
                    <div class="modal_wrapper nodisplay">
                        <div id="alchol_@(alcoholDataEntity.ResultId)_modal" class="modal_window" data-result_id="@alcoholDataEntity.ResultId">
                            <div class="alcohol_detail_modal">
                                <p class="food_image_modal_container">
                                    @if (@alcoholDataEntity.Image == "")
                                    {
                                        <img src="/image/noImage.jpg" class="food_image" alt="image" />
                                    }
                                    else
                                    {
                                        <a href="@(alcoholDataEntity.Image)" class="food_image_wrapper js-smartPhoto" data-caption="test" data-id="test" data-group="sake">
                                            <img src="@(alcoholDataEntity.Image)" class="food_image" />
                                        </a>
                                    }
                                    @if (alcoholDataEntity.Ordered)
                                    {
                                        <img src="/image/ordered.png" class="orderd" alt="image" />
                                    }
                                    @switch (alcoholDataEntity.Rarity)
                                    {
                                        case 0:
                                            <img src="/image/zeroStars.png" class="star" />
                                            break;
                                        case 1:
                                            <img src="/image/singleStars.png" class="star" />
                                            break;
                                        case 2:
                                            <img src="/image/doubleStars.png" class="star" />
                                            break;
                                        case 3:
                                            <img src="/image/tripleStars.png" class="star" />
                                            break;
                                        case 4:
                                            <img src="/image/quadStars.png" class="star" />
                                            break;
                                        case 5:
                                            <img src="/image/fiveStars.png" class="star" />
                                            break;
                                        case 6:
                                            <img src="/image/sixStars.png" class="star" />
                                            break;
                                    }
                                </p>
                                <p class="alcoholName">
                                    <span>@alcoholDataEntity.AlcoholName</span>
                                </p>
                                <p class="alcohol_modal_poncoin">
                                    <img src="/image/poncoin.png" alt="image" />
                                    <span> × </span>
                                    <span class="coin_number_modal_show">@(alcoholDataEntity.CoinNumber * 5 - alcoholDataEntity.CoinNumber)</span>
                                </p>
                                <table>
                                    <tr>
                                        <td>酒造</td>
                                        <td class="brewery">@alcoholDataEntity.Brewery</td>
                                    </tr>
                                    <tr>
                                        <td>都道府県</td>
                                        <td class="prefectures">@alcoholDataEntity.Prefectures</td>
                                    </tr>
                                    <tr>
                                        <td>原料米</td>
                                        <td class="genryoMai">@alcoholDataEntity.GenryoMai</td>
                                    </tr>
                                    <tr>
                                        <td>特定名称</td>
                                        <td class="speciallyDesignated">@alcoholDataEntity.SpeciallyDesignated</td>
                                    </tr>
                                    <tr>
                                        <td>精米歩合</td>
                                        <td class="ricePolishingRatio">@(alcoholDataEntity.RicePolishingRatio)%</td>
                                    </tr>
                                    <tr>
                                        <td>日本酒度</td>
                                        <td class="sakeMeterValue">@Convert.ToString(alcoholDataEntity.SakeMeterValue ?? 0).TrimEnd('0').TrimEnd('.')</td>
                                    </tr>
                                    <tr>
                                        <td>酸度</td>
                                        <td class="acidRate">@Convert.ToString(alcoholDataEntity.AcidRate ?? 0).TrimEnd('0').TrimEnd('.')</td>
                                    </tr>
                                    <tr>
                                        <td>度数</td>
                                        <td class="abv">@(alcoholDataEntity.RicePolishingRatio)度</td>
                                    </tr>
                                </table>
                                <p>
                                    <select class="alcohol_amount_modal">
                                        <option value="36">2勺(36ml)</option>
                                        <option value="180" selected>1合(180ml)</option>
                                        <option value="0">1瓶(全量)</option>
                                    </select>
                                    <span>×</span>
                                    <select class="order_number_modal">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <option value="@i">@i</option>
                                        }
                                    </select>
                                </p>
                                <p>
                                    <button class="order_button" type="button">注文に追加</button>
                                    <button class="close_modal" type="button">閉じる</button>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>