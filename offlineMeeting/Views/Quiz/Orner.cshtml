@using offlineMeeting.Models.Entity.Quiz
@{
    ViewData["Title"] = "QuizOrner";
}
@section Scripts {
    <script src="~/js/dist/QuizOrner.js" defer></script>
    <link rel="stylesheet" href="~/css/Quiz/Index.css" asp-append-version="true" />
}
@model offlineMeeting.Models.ViewModel.QuizViewModel
<!--問題の表示-->
<div id="quiz">
    <p>番号：@(Model.QuizEntity?.ResultId)</p>
    <input id="quiz_id" type="text" class="nodisplay" value="@(Model.QuizEntity?.ResultId)" />
    <p>@(Model.QuizEntity?.Quiz)</p>
    @if (!string.IsNullOrEmpty(Model.QuizEntity?.QuizImage))
    {
        <img src="@(Model.QuizEntity?.QuizImage)" class="quiz_image" />
    }
    <p>ヒント</p>
    <p>@(Model.QuizEntity?.Hint)</p>
    <p>最高点:@(Model.QuizEntity?.MaxPoint)</p>
    <p>回答:@(Model.QuizEntity?.Answer)</p>
    <p>解説</p>
    <p>@(Model.QuizEntity?.Explanation)</p>
    <p><button id="send_quiz" type="button" value="send_quiz">問題送信</button></p>
</div>

<!--userの答えはここに列挙される-->
<div id="answer_list">
    @if (Model.AnswerEntityList != null)
    {
        foreach (AnswerEntity answerEntity in Model.AnswerEntityList)
        {
            <div class="answer">
                <div>
                    <img src="@(answerEntity.Image)" class="quiz_image" />
                </div>
                <div>
                    <p>@(answerEntity.UserName)</p>
                    <input type="text" class="user_cd nodisplay" />
                    <p>
                        <input type="number" class="point" min="0" max="@(answerEntity.MaxPoint)" value="@(answerEntity.Point)" />
                        <span>点</span>
                    </p>
                    <p>@(answerEntity.AnswerTime)</p>
                </div>
                <input type="text" class="answer_id nodisplay" value="@(answerEntity.ResultId)" />
            </div>

        }
    }
</div>
<div>
    <button id="send_points" type="button" value="send_points">ポイント確定</button>
</div>