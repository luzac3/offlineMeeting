@using offlineMeeting.Models.Entity.Quiz
@{
    ViewData["Title"] = "QuizOrner";
}
@section Scripts {
    <script src="~/js/dist/Quiz.js" defer></script>
    <link rel="stylesheet" href="~/css/Quiz/Index.css" asp-append-version="true" />
}
@model offlineMeeting.Models.ViewModel.QuizViewModel
<!--問題の表示-->
<div id="quiz">
    <p>番号：@(Model.QuizEntity?.ResultId)</p>
    <input id="quiz_id" type="text" class="nodisplay" value="@(Model.QuizEntity?.ResultId)" />
    <p>@(Model.QuizEntity?.Quiz)</p>
    @if (@Model.QuizEntity?.QuizImage != "")
    {
        <img src="@(Model.QuizEntity?.QuizImage)" class="quiz_image" />
    }
    <p>@(Model.QuizEntity?.Hint)</p>
    <p>@(Model.QuizEntity?.MaxPoint)</p>
    <p>@(Model.QuizEntity?.Answer)</p>
    <p>@(Model.QuizEntity?.Explanation)</p>
    <p><button id="send_quiz" type="button" value="send_quiz">問題送信</button></p>
</div>

<!--userの答えはここに列挙される-->
<div id="answer_list">
</div>
<div>
    <button type="button" value="sendPoints">ポイント確定</button>
</div>