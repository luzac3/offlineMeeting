@using offlineMeeting.Models.Entity.Quiz
@{
    ViewData["Title"] = "QuizList";
}
@section Scripts {
    <script src="~/js/QuizOrner.js" defer></script>
    <link rel="stylesheet" href="~/css/Quiz/Index.css" asp-append-version="true" />
}
@model offlineMeeting.Models.ViewModel.QuizViewModel

<div id="quiz_list">
    @{
        @foreach (QuizEntity quizEntity in Model.QuizEntityList ?? new List<offlineMeeting.Models.Entity.Quiz.QuizEntity> { })
        {
            <p>
                <span>@(quizEntity.Quiz)-</span>
                <a asp-area="" asp-controller="Quiz" asp-action="Orner" asp-route-id="@(Convert.ToInt32(quizEntity.ResultId))">管理者</a>
                <span> - </span>
                <a asp-area="" asp-controller="Quiz" asp-action="ShowQuiz" asp-route-id="@(Convert.ToInt32(quizEntity.ResultId))">リスト</a>
            </p>
        }
    }
</div>
<div>
    <br /><button id="back" type="button">戻る</button>
</div>