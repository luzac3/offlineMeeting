@{
    ViewData["Title"] = "Quiz";
}
@section Scripts {
    <script src="~/js/dist/Quiz.js" defer></script>
    <link rel="stylesheet" href="~/css/Quiz/Index.css" asp-append-version="true" />
}
<div id="quiz"></div>
<div id ="answer_container">
    <canvas id="textCanvas"></canvas>
    <div class="quiz-buttons">
        <button id="clear">クリア</button>
        <button id="send">確定</button>
    </div>
    <input id="quiz_id" type="text" class="nodisplay" value="" />
</div>