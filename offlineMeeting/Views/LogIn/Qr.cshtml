@using offlineMeeting.Models.Entity.Login;

@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Login";
}
@section Scripts {
    <script src="~/js/dist/Login.js" defer></script>
    <script src="~/plugins/qrcode.min.js"></script>
    <link rel="stylesheet" href="~/css/Login/Index.css" asp-append-version="true" />
}
@model offlineMeeting.Models.ViewModel.LoginViewModel;


<div id="main">
    <div id="qr" class="container m-4 is-justify-content-center is-flex"></div>
    <input type="text" id="qr_input" class="nodisplay" value="@(Html.Raw(Model?.url + "?eid=" + (Model?.GenerateQr?.EventId ?? 0) + "&uid=" + (Model?.GenerateQr?.UserId ?? 0)))" />
</div>