@using offlineMeeting.Models.Entity.Login;

@{
    ViewData["Title"] = "Login";
}
@section Scripts {
    <script src="~/js/dist/Login.js" defer></script>
    <script src="qrcode.min.js"></script>
    <link rel="stylesheet" href="~/css/Home/Login.css" asp-append-version="true" />
}
@model offlineMeeting.Models.ViewModel.LoginViewModel;

<div id="main">
    <div id="qr" class="container m-4 is-justify-content-center is-flex"></div>
    <input type="text" id="qr_input" class="nodisplay" value="https://sake.wolfslab.jp/Login/QrRegister?uid=@(Model?.GenerateQr?.UserId ?? 0)" />
</div>