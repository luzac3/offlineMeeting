<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 百酒会</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/plugin/material-symbols/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modal.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div id="menu" class="container-fluid">
                <div id="name_wrapper">
                    <span id="user_name">るざ狼</span>
                </div>
                <div id="level_wrapper">
                    <span>Lv:</span>
                    <span id="levels">1</span>
                    <span>(</span>
                    <span id="exp_now">0</span>
                    <span>/</span>
                    <span id="exp_next">5</span>
                    <span>)</span>
                </div>
                <div id="coins_wrapper">
                    <a asp-area="" asp-controller="Coins" asp-action="Index">
                        <img id="poncoin_img" src="/image/poncoin.png" />
                        <span id="poncoins">120</span>
                        <span>枚</span>
                    </a>
                </div>
                <button b-c19eioo5et class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span b-c19eioo5et class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark dot" asp-area="" asp-controller="Home" asp-action="Index">ホーム</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark dot" asp-area="" asp-controller="Pos" asp-action="Index">ショクジ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark dot" asp-area="" asp-controller="Pos" asp-action="Alcohol">オサケ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark dot" asp-area="" asp-controller="Pos" asp-action="OrderList">チュウモンカクニン</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark dot" asp-area="" asp-controller="Collection" asp-action="Index">ズカン</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark dot" asp-area="" asp-controller="Collection" asp-action="Achievements">ジッセキ</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - offlineMeeting - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/signalR/hubs"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
