<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 百酒会</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/plugin/material-symbols/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modal.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div id="menu" class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">百酒会</a>
                <span>ポンコイン</span>
                <input id="event_id" type="text" value="1" class="nodisplay" />
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark dot" asp-area="" asp-controller="Pos" asp-action="Index">ショクジ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark dot" asp-area="" asp-controller="Pos" asp-action="Alcohol">オサケ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark dot" asp-area="" asp-controller="Pos" asp-action="OrderList">チュウモンカクニン</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark dot" asp-area="" asp-controller="Collection" asp-action="Index">ズカン</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark dot" asp-area="" asp-controller="Achievements" asp-action="Index">ジッセキ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark dot" asp-area="" asp-controller="Home" asp-action="Index">ホーム</a>
                        </li>
                        <li id="painList" class="nav-item nodisplay">
                            <button id="painButton" type="button" value="painButton">映像・ゲーム処理</button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - offlineMeeting - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/signalR/hubs"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
