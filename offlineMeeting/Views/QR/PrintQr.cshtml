@{
    Layout = "~/Views/Shared/_LayoutPrint.cshtml";
}
@section Scripts {
    <link rel="stylesheet" href="~/css/QR/PrintQr.css" asp-append-version="true" />
    <script src="~/plugins/qrcode.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var el = document.getElementById('print_qr_code');
            var url = el.getAttribute('data-url');
            if (url) {
                new QRCode(el, {
                    text: url,
                    width: 128,
                    height: 128,
                    correctLevel: QRCode.CorrectLevel.H
                });
            }
        });
    </script>
}
@model offlineMeeting.Models.ViewModel.PrintQRViewModel

<div id="print_qr">
    <h1 class="print_user_name">@Model.UserName</h1>
    <div id="print_qr_code" data-url="@Model.QrUrl"></div>
</div>