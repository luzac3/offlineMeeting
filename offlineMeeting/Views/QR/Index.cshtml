@using offlineMeeting.Models.Entity.Share;

@{
    ViewData["Title"] = "QR発行";
}
@section Styles {
    <link rel="stylesheet" href="~/css/QR/Index.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/plugins/qrcode.min.js"></script>
    <script src="~/js/QR.js" defer></script>
}
@model offlineMeeting.Models.ViewModel.QRViewModel;

<h2 class="dot">チェックイン</h2>

<div id="qr_display" class="nodisplay">
    <h3 id="qr_user_name_display" class="dot"></h3>
    <div id="qr_code_display"></div>
</div>

<div id="joiner_list">
    @if (Model?.JoinerList != null && Model.JoinerList.Count > 0)
    {
        @foreach (var joiner in Model.JoinerList)
        {
            <div class="joiner_row" data-usercd="@joiner.UserCd" data-username="@joiner.UserName"
                 data-qrurl="@(Model.BaseUrl)?eid=@(Model.EventId)&uid=@(joiner.UserCd)">
                <span class="joiner_name dot">@joiner.UserName</span>
                <button class="btn_checkin" type="button">チェックイン</button>
            </div>
        }
    }
    else
    {
        <p>参加者が見つかりませんでした。</p>
    }
</div>