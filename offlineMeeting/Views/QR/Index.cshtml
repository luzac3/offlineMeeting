@using offlineMeeting.Models.Entity.Share;

@{
    ElectronEntity? electron = ViewData["Electron"] as ElectronEntity;
    @if (electron?.IsElectron == true)
    {
        Layout = "~/Views/Shared/_LayoutElectron.cshtml";
    }
    ViewData["Title"] = "スタート";
    var startUrl = Url.Action("Start", "QR");
}
@section Styles {
    <link rel="stylesheet" href="~/css/QR/Start.css" asp-append-version="true" />
}

<a id="start_screen" href="@startUrl">
    @* 背景画像は後で画面全体に配置する。ここは枠のみ用意 *@
    <img id="start_bg" src="" alt="" />

    <div id="start_touch">TOUCH START</div>
</a>