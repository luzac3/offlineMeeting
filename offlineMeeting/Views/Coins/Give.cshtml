@using offlineMeeting.Models.Entity.Share;
@model offlineMeeting.Models.ViewModel.GiveCoinsViewModel;

@{
    ViewData["Title"] = "GiveCoins";
}
@section Scripts {
    <script src="~/js/dist/Coins.js" defer></script>
    <link rel="stylesheet" href="~/css/Coins/Index.css" asp-append-version="true" />
}
<div id="coins">
    <p>※譲渡の際は、20％の手数料(最低1枚)がかかります。</p>
    <table>
        <tr>
            <th>譲渡先</th>
            <th>枚数</th>
        </tr>
        <tr>
            <td>
                <select id="for_user_cd">
                    @{
                        JoinerEntity? userData = ViewData["UserData"] as offlineMeeting.Models.Entity.Share.JoinerEntity;
                        foreach (KeyValuePair<int, string> user in Model.Users)
                        {
                            if (userData?.UserCd == user.Key.ToString())
                            {
                                continue;
                            }
                            <option value="@user.Key">@user.Value</option>
                        }
                    }
                </select>
            </td>
            <td class="counter">
                <button type="button" class="counter_decrement">-</button>
                <!--最小値は1で、コインを持っていない場合はグレーアウト-->
                @{
                    if (userData?.Coins == 0)
                    {
                        <input type="number" class="counter_number" value="0" min="1" max="1" disabled/>
                    }
                    else
                    {
                        <input type="number" class="counter_number" value="0" min="1" max="@(userData?.Coins)" />
                    }
                }
                <button type="button" class="counter_increment">+</button>
            </td>
        </tr>
    </table>
    <div>
        <br />
        <button id="give" type="button">譲渡</button>
        <button id="back" type="button">戻る</button>
    </div>
</div>