    <link rel="stylesheet" href="~/css/Coins/Index.css" asp-append-version="true" />
}
<div class="index_menu">
    <p><a class="nav-link text-dark dot" asp-area="" asp-controller="Coins" asp-action="Buy">コウニュウ</a></p>
    <p><a class="nav-link text-dark dot" asp-area="" asp-controller="Coins" asp-action="Give">ジョウト</a></p>
</div>